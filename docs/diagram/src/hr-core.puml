
@startuml HR_Core_Payroll_ERD

' ==========================================
' HR CORE & PAYROLL DATABASE
' PostgreSQL Database Design
' ==========================================

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #1E293B
}
skinparam ArrowColor #64748B

title HR CORE - ROLE BASED USER MANAGEMENT & PAYROLL ERD

' ==========================================
' 1. ENTERPRISE & USER MANAGEMENT
' ==========================================

entity "enterprises" as enterprises {
    * enterprise_id : BIGINT <<PK>>
    --
    company_name : VARCHAR(150)
    company_code : VARCHAR(50)
    email : VARCHAR(150)
    phone : VARCHAR(30)
    address : TEXT
    tax_number : VARCHAR(50)
    status : VARCHAR(20)
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "users" as users {
    * user_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    full_name : VARCHAR(150)
    email : VARCHAR(150) <<UNIQUE>>
    password_hash : VARCHAR(255)
    is_active : BOOLEAN
    last_login_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

entity "roles" as roles {
    * role_id : BIGINT <<PK>>
    --
    role_name : VARCHAR(50) <<UNIQUE>>
    description : TEXT
    created_at : TIMESTAMPTZ
}

entity "permissions" as permissions {
    * permission_id : BIGINT <<PK>>
    --
    permission_name : VARCHAR(100) <<UNIQUE>>
    module_name : VARCHAR(50)
    description : TEXT
}

entity "user_roles" as user_roles {
    * user_role_id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK>>
    role_id : BIGINT <<FK>>
    assigned_at : TIMESTAMPTZ
}

entity "role_permissions" as role_permissions {
    * role_permission_id : BIGINT <<PK>>
    --
    role_id : BIGINT <<FK>>
    permission_id : BIGINT <<FK>>
}

' ==========================================
' 2. HR CORE MODULE
' ==========================================

entity "departments" as departments {
    * department_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    department_name : VARCHAR(100)
    description : TEXT
    created_at : TIMESTAMPTZ
}

entity "positions" as positions {
    * position_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    position_name : VARCHAR(100)
    description : TEXT
    created_at : TIMESTAMPTZ
}

entity "employees" as employees {
    * employee_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    user_id : BIGINT <<FK, NULL>>
    department_id : BIGINT <<FK>>
    position_id : BIGINT <<FK>>
    employee_number : VARCHAR(50)
    first_name : VARCHAR(100)
    last_name : VARCHAR(100)
    gender : VARCHAR(20)
    date_of_birth : DATE
    email : VARCHAR(150)
    phone : VARCHAR(30)
    hire_date : DATE
    employment_status : VARCHAR(30)
    basic_salary : NUMERIC(15,2)
    created_at : TIMESTAMPTZ
    updated_at : TIMESTAMPTZ
}

' ==========================================
' 3. PAYROLL MODULE
' ==========================================

entity "payroll_periods" as payroll_periods {
    * period_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    period_name : VARCHAR(100)
    start_date : DATE
    end_date : DATE
    payment_date : DATE
    status : VARCHAR(30)
    created_at : TIMESTAMPTZ
}

entity "payrolls" as payrolls {
    * payroll_id : BIGINT <<PK>>
    --
    period_id : BIGINT <<FK>>
    employee_id : BIGINT <<FK>>
    basic_salary : NUMERIC(15,2)
    total_earnings : NUMERIC(15,2)
    total_deductions : NUMERIC(15,2)
    gross_salary : NUMERIC(15,2)
    net_salary : NUMERIC(15,2)
    payment_status : VARCHAR(30)
    processed_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

entity "payroll_components" as payroll_components {
    * component_id : BIGINT <<PK>>
    --
    enterprise_id : BIGINT <<FK>>
    component_name : VARCHAR(100)
    component_type : VARCHAR(20)
    calculation_type : VARCHAR(20)
    default_amount : NUMERIC(15,2)
    description : TEXT
    is_active : BOOLEAN
}

entity "payroll_details" as payroll_details {
    * payroll_detail_id : BIGINT <<PK>>
    --
    payroll_id : BIGINT <<FK>>
    component_id : BIGINT <<FK>>
    amount : NUMERIC(15,2)
    description : TEXT
}

' ==========================================
' 4. PAYROLL MILESTONE MODULE
' ==========================================

entity "payroll_milestones" as payroll_milestones {
    * milestone_id : BIGINT <<PK>>
    --
    period_id : BIGINT <<FK>>
    milestone_name : VARCHAR(150)
    description : TEXT
    sequence_number : INTEGER
    due_date : DATE
    status : VARCHAR(30)
    completed_by : BIGINT <<FK, NULL>>
    completed_at : TIMESTAMPTZ
    created_at : TIMESTAMPTZ
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' Enterprise relationships
enterprises ||--o{ users : owns
enterprises ||--o{ departments : has
enterprises ||--o{ positions : defines
enterprises ||--o{ employees : employs
enterprises ||--o{ payroll_periods : schedules
enterprises ||--o{ payroll_components : defines

' User access control
users ||--o{ user_roles : assigned
roles ||--o{ user_roles : has

roles ||--o{ role_permissions : grants
permissions ||--o{ role_permissions : assigned

' HR relationships
users ||--o| employees : linked_account
departments ||--o{ employees : contains
positions ||--o{ employees : assigned

' Payroll relationships
payroll_periods ||--o{ payrolls : contains
employees ||--o{ payrolls : receives

payrolls ||--o{ payroll_details : contains
payroll_components ||--o{ payroll_details : defines

' Milestone relationships
payroll_periods ||--o{ payroll_milestones : tracks
users |o--o{ payroll_milestones : completes

@enduml
